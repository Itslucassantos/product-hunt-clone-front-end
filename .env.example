# API (Express backend, all routes under /api)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3333

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Docker Compose only (docker compose up -d)
# Path to the backend repository (default: ../product-hunt-clone-backend)
# BACKEND_CONTEXT=../product-hunt-clone-backend
# Comma-separated Clerk user ids that become admins in the backend
ADMIN_EXTERNAL_IDS=
# Optional: enables the Clerk webhook in the backend
# CLERK_WEBHOOK_SECRET=
